{
  "schema_version": 1,
  "language_neutral": true,
  "domain": "scalar presence and normalization",
  "source_sections": ["4.1", "4.2", "4.3", "16"],
  "context": {
    "definition_revision": "defn-rev-scalars-fixture",
    "target_kind": "asset",
    "fields": {
      "serial": { "type": "text", "required": false, "nullable": false, "max_length": 4096 },
      "code": { "type": "text", "required": false, "nullable": false, "max_length": 5 },
      "owner_note": { "type": "text", "required": false, "nullable": false },
      "required_text": { "type": "text", "required": true, "nullable": false },
      "quantity": { "type": "integer", "required": false, "nullable": false, "min": -9007199254740991, "max": 9007199254740991 },
      "cost": { "type": "decimal", "required": false, "nullable": false, "scale": 2, "integral_digits_max": 18 },
      "active": { "type": "boolean", "required": false, "nullable": true },
      "approved": { "type": "boolean", "required": true, "nullable": false },
      "purchase_date": { "type": "date", "required": false, "nullable": false },
      "status": { "type": "single_select", "required": false, "nullable": false, "choice_set": { "active": ["in_service", "retired"], "deprecated": ["old_status"] } },
      "tags": { "type": "multi_select", "required": false, "nullable": false, "max_values": 8 },
      "required_tags": { "type": "multi_select", "required": true, "nullable": false, "max_values": 8 }
    }
  },
  "cases": [
    {
      "id": "T02-SCALAR-001",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "active": false } },
      "expected_result": { "outcome": "accepted", "stored": { "active": false } },
      "expected_unchanged": {},
      "rationale": "set[key]=false persists false; never treated as omitted or missing. An unset Boolean is not turned into false merely by opening the form."
    },
    {
      "id": "T02-SCALAR-002",
      "invariant": "Presence and normalization",
      "acceptance": "A11",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "quantity": 0 } },
      "expected_result": { "outcome": "accepted", "stored": { "quantity": 0 } },
      "expected_unchanged": {},
      "rationale": "set[key]=0 persists integer zero if bounds permit; integer zero is distinct from missing and from the empty string."
    },
    {
      "id": "T02-SCALAR-003",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "owner_note": "" } },
      "expected_result": { "outcome": "accepted", "stored": { "owner_note": "" } },
      "expected_unchanged": {},
      "rationale": "set[key]=\"\" stores empty optional text; the empty string is a value for optional text, distinct from missing."
    },
    {
      "id": "T02-SCALAR-004",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "required_text": "" } },
      "expected_result": { "outcome": "rejected", "error": "REQUIRED_FIELD", "path": ["set", "required_text"] },
      "expected_unchanged": {},
      "rationale": "set[key]=\"\" is rejected for required text; an empty string never satisfies a required field."
    },
    {
      "id": "T02-SCALAR-005",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "required_text": "   " } },
      "expected_result": { "outcome": "rejected", "error": "REQUIRED_FIELD", "path": ["set", "required_text"] },
      "expected_unchanged": {},
      "rationale": "Whitespace-only text does not satisfy requiredness; form adapters must not trim. Rejection is domain-level, not adapter-level."
    },
    {
      "id": "T02-SCALAR-006",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "active": null } },
      "expected_result": { "outcome": "accepted", "stored": { "active": null } },
      "expected_unchanged": {},
      "rationale": "set[key]=null stores explicit null only if nullable (active is nullable). Explicit null is distinct from missing and never satisfies a required field."
    },
    {
      "id": "T02-SCALAR-007",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "required_text": null } },
      "expected_result": { "outcome": "rejected", "error": "REQUIRED_FIELD", "path": ["set", "required_text"] },
      "expected_unchanged": {},
      "rationale": "set[key]=null never satisfies a required field."
    },
    {
      "id": "T02-SCALAR-008",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "serial": null } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "serial"] },
      "expected_unchanged": {},
      "rationale": "set[key]=null is stored only if nullable; serial is not nullable, so explicit null is invalid for it."
    },
    {
      "id": "T02-SCALAR-009",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": { "serial": "ABC-1", "quantity": 5 },
      "operation": { "kind": "patch", "set": { "owner_note": "hi" } },
      "expected_result": { "outcome": "accepted", "stored": { "serial": "ABC-1", "quantity": 5, "owner_note": "hi" } },
      "expected_unchanged": { "serial": "ABC-1", "quantity": 5 },
      "rationale": "A key absent from the patch leaves its stored state untouched, byte-for-value."
    },
    {
      "id": "T02-SCALAR-010",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "tags": [] } },
      "expected_result": { "outcome": "accepted", "stored": { "tags": [] } },
      "expected_unchanged": {},
      "rationale": "set[key]=[] is an explicitly empty selection for an optional multi-select, distinct from missing."
    },
    {
      "id": "T02-SCALAR-011",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.2",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "required_tags": [] } },
      "expected_result": { "outcome": "rejected", "error": "REQUIRED_FIELD", "path": ["set", "required_tags"] },
      "expected_unchanged": {},
      "rationale": "A required multi-select rejects an explicit empty selection."
    },
    {
      "id": "T02-SCALAR-012",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "12.345" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "Decimal scale is 2; excess precision is rejected instead of rounding. A value with more fractional digits than the scale never rounds to fit."
    },
    {
      "id": "T02-SCALAR-013",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "12.3" } },
      "expected_result": { "outcome": "accepted", "stored": { "cost": "12.30" } },
      "expected_unchanged": {},
      "rationale": "Fewer fractional digits than the scale are accepted and padded to the fixed scale."
    },
    {
      "id": "T02-SCALAR-014",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "007.50" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "Leading zeroes are not part of the canonical fixed-scale base-10 string representation."
    },
    {
      "id": "T02-SCALAR-015",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "1e3" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "No exponent is permitted in the fixed-scale decimal string representation."
    },
    {
      "id": "T02-SCALAR-016",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "+1.50" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "No plus prefix is permitted in the canonical decimal string representation."
    },
    {
      "id": "T02-SCALAR-017",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "-0.00" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "Negative zero is forbidden in the canonical decimal string representation."
    },
    {
      "id": "T02-SCALAR-018",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "NaN" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "NaN and infinity (for example 'Infinity', '-Infinity') are not valid decimal strings."
    },
    {
      "id": "T02-SCALAR-019",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "cost": "1234567890123456789.00" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DECIMAL", "path": ["set", "cost"] },
      "expected_unchanged": {},
      "rationale": "At most 18 integral digits are allowed; 19 integral digits exceed the representation bound."
    },
    {
      "id": "T02-SCALAR-020",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "quantity": true } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "quantity"] },
      "expected_unchanged": {},
      "rationale": "Booleans are not integers for an Integer field."
    },
    {
      "id": "T02-SCALAR-021",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "quantity": "5" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "quantity"] },
      "expected_unchanged": {},
      "rationale": "Numeric strings are not integers at the canonical boundary; no coercion at the domain boundary."
    },
    {
      "id": "T02-SCALAR-022",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "quantity": 5.5 } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "quantity"] },
      "expected_unchanged": {},
      "rationale": "Fractional values are not integers."
    },
    {
      "id": "T02-SCALAR-023",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "quantity": 9007199254740992 } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_RANGE", "path": ["set", "quantity"] },
      "expected_unchanged": {},
      "rationale": "The integer range is -9007199254740991..9007199254740991; the value exceeds the maximum."
    },
    {
      "id": "T02-SCALAR-024",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "approved": 1 } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "approved"] },
      "expected_unchanged": {},
      "rationale": "No 0/1 coercion for Boolean at the domain boundary."
    },
    {
      "id": "T02-SCALAR-025",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "approved": "true" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "approved"] },
      "expected_unchanged": {},
      "rationale": "No \"true\"/\"false\" string coercion at the domain boundary; Boolean is JSON true or false only."
    },
    {
      "id": "T02-SCALAR-026",
      "invariant": "Presence and normalization",
      "acceptance": "A05",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "approved": false } },
      "expected_result": { "outcome": "accepted", "stored": { "approved": false } },
      "expected_unchanged": {},
      "rationale": "Both true and false satisfy required presence; required never means 'true'. Boolean false is a satisfied required value."
    },
    {
      "id": "T02-SCALAR-027",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "purchase_date": "2024-02-30" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DATE", "path": ["set", "purchase_date"] },
      "expected_unchanged": {},
      "rationale": "Date must be a real calendar date; 2024-02-30 does not exist."
    },
    {
      "id": "T02-SCALAR-028",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "purchase_date": "2024-2-3" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DATE", "path": ["set", "purchase_date"] },
      "expected_unchanged": {},
      "rationale": "Date representation is exactly YYYY-MM-DD; month and day are zero-padded, so non-padded forms are invalid."
    },
    {
      "id": "T02-SCALAR-029",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "purchase_date": "2024-01-01T00:00:00" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_DATE", "path": ["set", "purchase_date"] },
      "expected_unchanged": {},
      "rationale": "Date carries no time and no timezone; a timestamp string is not a date."
    },
    {
      "id": "T02-SCALAR-030",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "serial": "a\u0000b" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_TYPE", "path": ["set", "serial"] },
      "expected_unchanged": {},
      "rationale": "Text rejects NUL input; unpaired surrogates are also rejected. Unicode, case and whitespace are otherwise preserved exactly."
    },
    {
      "id": "T02-SCALAR-031",
      "invariant": "Presence and normalization",
      "acceptance": "A12",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "code": "ABCDEF" } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_RANGE", "path": ["set", "code"] },
      "expected_unchanged": {},
      "rationale": "Text maximum is 4096 code points plus the configured tighter bound; here the configured bound is 5 code points and 6 exceed it."
    },
    {
      "id": "T02-SCALAR-032",
      "invariant": "Merge preservation",
      "acceptance": "A06",
      "source_section": "4.2",
      "initial_state": { "serial": "ABC-1" },
      "operation": { "kind": "patch", "set": { "serial": "ABC-2" }, "clear": ["serial"] },
      "expected_result": { "outcome": "rejected", "error": "CONFLICT_CLEAR_OVERLAP", "path": [] },
      "expected_unchanged": { "serial": "ABC-1" },
      "rationale": "The same key in set and clear rejects the whole operation; nothing is partially applied (rollback all)."
    },
    {
      "id": "T02-SCALAR-033",
      "invariant": "Merge preservation",
      "acceptance": "A06",
      "source_section": "4.2",
      "initial_state": { "serial": "ABC-1" },
      "operation": { "kind": "patch", "set": { "serial": "ABC-2", "unknown_key": "x" } },
      "expected_result": { "outcome": "rejected", "error": "UNKNOWN_FIELD_KEY", "path": ["set", "unknown_key"] },
      "expected_unchanged": { "serial": "ABC-1" },
      "rationale": "An unknown submitted key rejects the whole request even when it also contains valid keys; no client-supplied claim of historical authorization is accepted."
    },
    {
      "id": "T02-SCALAR-034",
      "invariant": "Merge preservation",
      "acceptance": "A06",
      "source_section": "4.2",
      "initial_state": { "serial": "ABC-1" },
      "operation": { "kind": "patch", "set_list": [["serial", "ABC-2"], ["serial", "ABC-3"]] },
      "expected_result": { "outcome": "rejected", "error": "DUPLICATE_FIELD", "path": ["set"] },
      "expected_unchanged": { "serial": "ABC-1" },
      "rationale": "A repeated key in a GraphQL setter list rejects the whole patch; last-write-wins inside one patch is never applied."
    },
    {
      "id": "T02-SCALAR-035",
      "invariant": "Presence and normalization",
      "acceptance": "A11",
      "source_section": "4.1",
      "initial_state": {},
      "operation": { "kind": "patch", "set": { "tags": ["b", "a", "b"] } },
      "expected_result": { "outcome": "rejected", "error": "INVALID_CHOICE", "path": ["set", "tags"] },
      "expected_unchanged": {},
      "rationale": "Multi-select is an array of unique Choice key strings; duplicate keys in one submission violate the canonical representation. New canonical writes sort by key."
    },
    {
      "id": "T02-SCALAR-036",
      "invariant": "Merge preservation",
      "acceptance": "A05",
      "source_section": "4.3",
      "initial_state": { "cost": "not-a-decimal" },
      "operation": { "kind": "patch", "set": { "owner_note": "hi" } },
      "expected_result": { "outcome": "accepted", "stored": { "cost": "not-a-decimal", "owner_note": "hi" } },
      "expected_unchanged": { "cost": "not-a-decimal" },
      "rationale": "An optional structurally invalid existing value is preserved byte-for-value on an unrelated edit and flagged invalid, never silently reinterpreted or deleted, and never blocks the unrelated correction."
    }
  ]
}