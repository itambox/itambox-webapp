{
  "schema_version": 1,
  "language_neutral": true,
  "domain": "three-way reconciliation (B/L/R) and snapshots",
  "source_sections": ["8.2", "16"],
  "context": {
    "managed_path_semantics": {
      "composition": "atomic path value",
      "multi_select_value": "atomic path value",
      "permission_field": "never a managed path",
      "tenant_id": "never a managed path",
      "audit_policy": "never a managed path"
    },
    "baseline_rule": "After keep local, the new baseline is R, not L; otherwise future imports forget that the object is intentionally divergent.",
    "acceptable_decisions": ["unchanged", "upstream_safe", "local_override", "converged", "conflict_keep_local", "conflict_take_upstream", "conflict_abort"]
  },
  "cases": [
    {
      "id": "T02-REC-001",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Rene" },
        "R": { "f2_owner": "Rene" }
      },
      "operation": { "kind": "three_way_compare", "path": "f2_owner" },
      "expected_result": { "outcome": "decision", "decision": "unchanged", "proposed": false, "requires_approval": false },
      "expected_unchanged": { "B": { "f2_owner": "Rene" }, "L": { "f2_owner": "Rene" }, "R": { "f2_owner": "Rene" }, "baseline": "B" },
      "rationale": "L == B and R == B: Unchanged. No proposal is created."
    },
    {
      "id": "T02-REC-002",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Rene" },
        "R": { "f2_owner": "IT" }
      },
      "operation": { "kind": "three_way_compare", "path": "f2_owner" },
      "expected_result": { "outcome": "decision", "decision": "upstream_safe", "proposed": true, "requires_approval": true },
      "expected_unchanged": { "B": { "f2_owner": "Rene" }, "L": { "f2_owner": "Rene" }, "R": { "f2_owner": "IT" } },
      "rationale": "L == B and R != B: the upstream change is safe to propose automatically; applying it still requires approval of the whole preview."
    },
    {
      "id": "T02-REC-003",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Local" },
        "R": { "f2_owner": "Rene" }
      },
      "operation": { "kind": "three_way_compare", "path": "f2_owner" },
      "expected_result": { "outcome": "decision", "decision": "local_override", "proposed": false, "kept": "L" },
      "expected_unchanged": { "B": { "f2_owner": "Rene" }, "L": { "f2_owner": "Local" }, "R": { "f2_owner": "Rene" } },
      "rationale": "L != B and R == B: preserve the local override; no upstream proposal."
    },
    {
      "id": "T02-REC-004",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Service" },
        "R": { "f2_owner": "Service" }
      },
      "operation": { "kind": "three_way_compare", "path": "f2_owner", "source_release_changed": true },
      "expected_result": { "outcome": "decision", "decision": "converged", "retained": "L", "baseline_advanced_to": "R" },
      "expected_unchanged": { "L": { "f2_owner": "Service" }, "R": { "f2_owner": "Service" } },
      "rationale": "L == R: converged; retain the common value and advance the baseline when the source release changed."
    },
    {
      "id": "T02-REC-005",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Local" },
        "R": { "f2_owner": "IT" }
      },
      "operation": { "kind": "three_way_compare", "path": "f2_owner" },
      "expected_result": { "outcome": "decision", "decision": "conflict_keep_local" },
      "expected_unchanged": { "B": { "f2_owner": "Rene" }, "L": { "f2_owner": "Local" }, "R": { "f2_owner": "IT" } },
      "rationale": "All differ: explicit conflict; the operator chooses keep-local or take-upstream for that path, or aborts."
    },
    {
      "id": "T02-REC-006",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Local" },
        "R": { "f2_owner": "IT" },
        "chosen": "keep_local"
      },
      "operation": { "kind": "apply_resolution", "path": "f2_owner", "resolution": "keep_local" },
      "expected_result": { "outcome": "accepted", "new_baseline_is": "R" },
      "expected_unchanged": { "L": { "f2_owner": "Local" }, "future_imports_see_divergence": true },
      "rationale": "After keep local, the new baseline is R, not L; otherwise future imports forget that the object is intentionally divergent."
    },
    {
      "id": "T02-REC-007",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "memberships": ["fs_personal", "fs_placement"] },
        "L": { "memberships": ["fs_personal", "fs_placement"] },
        "R": { "memberships": ["fs_personal", "fs_usage"] }
      },
      "operation": { "kind": "three_way_compare", "path": "composition" },
      "expected_result": {
        "outcome": "decision",
        "decision": "upstream_safe",
        "atomic": true,
        "merged_arrays": false
      },
      "expected_unchanged": {
        "L": { "memberships": ["fs_personal", "fs_placement"] },
        "index_based_auto_merge": "never applied"
      },
      "rationale": "Object/list paths such as composition are atomic path values; the incoming list differs at one position and the whole path is proposed as one atomic change, never merged per array index."
    },
    {
      "id": "T02-REC-008",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "tags": ["a", "b"] },
        "L": { "tags": ["a", "b"] },
        "R": { "tags": ["a", "b"] }
      },
      "operation": { "kind": "three_way_compare", "path": "multi_select_value", "note": "set semantics: value identity, not index position" },
      "expected_result": { "outcome": "decision", "decision": "unchanged", "atomic": true },
      "expected_unchanged": { "B": { "tags": ["a", "b"] }, "L": { "tags": ["a", "b"] }, "R": { "tags": ["a", "b"] } },
      "rationale": "A multi-select value is an atomic path value too; the comparison is over the set of Choice keys, and array indices are never auto-merged."
    },
    {
      "id": "T02-REC-009",
      "invariant": "Reconciliation",
      "acceptance": "A20",
      "source_section": "8.2",
      "initial_state": {
        "source_release": "lib-1.0",
        "local_state": { "f2_owner": "Local" },
        "effective_snapshot": null
      },
      "operation": { "kind": "compare_snapshots" },
      "expected_result": {
        "outcome": "accepted",
        "distinct": {
          "immutable_upstream_baseline": "B from last accepted release",
          "current_local_state": "L",
          "effective_snapshot": "separate export/provenance record"
        }
      },
      "expected_unchanged": { "source_release": "lib-1.0" },
      "rationale": "Immutable upstream baseline, current local state and effective snapshot are distinct; the effective snapshot is not the same record as the local working state."
    },
    {
      "id": "T02-REC-010",
      "invariant": "Reconciliation",
      "acceptance": "A20",
      "source_section": "16",
      "initial_state": {
        "accepted_upstream": "lib-2.0",
        "incoming": "lib-1.5"
      },
      "operation": { "kind": "propose_apply", "incoming_release": "lib-1.5" },
      "expected_result": { "outcome": "rejected", "error": "STALE_PLAN", "path": ["release"] },
      "expected_unchanged": { "accepted_upstream": "lib-2.0", "local_state": "untouched" },
      "rationale": "An older release than the accepted upstream baseline is refused; reconciliation only ever advances on a positive release sequence."
    },
    {
      "id": "T02-REC-011",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "16",
      "initial_state": {
        "release": "lib-2.0",
        "earlier_presented": { "f2_owner": "Rene" },
        "later_presented": { "f2_owner": "IT" }
      },
      "operation": { "kind": "propose_apply", "same_release": "lib-2.0", "path_value": { "f2_owner": "IT" } },
      "expected_result": { "outcome": "rejected", "error": "STALE_PLAN", "path": ["equivocation"] },
      "expected_unchanged": { "release": "lib-2.0", "earlier_presented": { "f2_owner": "Rene" } },
      "rationale": "Same-release equivocation (the identical release presenting different values at the same managed path) is rejected; a release is a complete positive-sequence snapshot with exact dependencies."
    },
    {
      "id": "T02-REC-012",
      "invariant": "Reconciliation",
      "acceptance": "A19",
      "source_section": "8.2",
      "initial_state": {
        "B": { "tenant_id": 7 },
        "L": { "tenant_id": 7 },
        "R": { "tenant_id": 9 }
      },
      "operation": { "kind": "three_way_compare", "path": "tenant_id" },
      "expected_result": { "outcome": "unmanaged", "managed_path": false },
      "expected_unchanged": { "B": { "tenant_id": 7 }, "L": { "tenant_id": 7 }, "R": { "tenant_id": 9 } },
      "rationale": "Managed path ownership is defined in application code by object kind, not supplied by the file; libraries cannot designate a permission field, tenant ID or audit policy as a managed path, so tenant_id is never reconciled."
    },
    {
      "id": "T02-REC-013",
      "invariant": "Reconciliation",
      "acceptance": "A20",
      "source_section": "16",
      "initial_state": {
        "catalogue": "shared",
        "local_objects": { "laptop-1": { "f2_owner": "Local" } }
      },
      "operation": { "kind": "apply_release", "release": "lib-2.0", "definitions": { "laptop": null } },
      "expected_result": {
        "outcome": "accepted",
        "retired_definition": "laptop",
        "shared_catalogue_deleted": false,
        "tenant_data_deleted": false
      },
      "expected_unchanged": { "local_objects": { "laptop-1": { "f2_owner": "Local" } }, "shared_catalogue": "preserved" },
      "rationale": "Omitted definitions retire in a complete positive-sequence snapshot; disappearance of a definition never deletes the shared catalogue or tenant data."
    },
    {
      "id": "T02-REC-014",
      "invariant": "Reconciliation",
      "acceptance": "A17",
      "source_section": "8.2",
      "initial_state": {
        "B": { "f2_owner": "Rene" },
        "L": { "f2_owner": "Rene" },
        "R": { "f2_owner": "IT" }
      },
      "operation": { "kind": "apply", "path": "f2_owner", "approval": "preview_only" },
      "expected_result": { "outcome": "rejected", "error": "MISSING_PRECONDITION", "path": ["approval"], "note": "auto-proposable upstream change still requires approval of the whole preview before apply" },
      "expected_unchanged": { "B": { "f2_owner": "Rene" }, "L": { "f2_owner": "Rene" }, "R": { "f2_owner": "IT" } },
      "rationale": "Even a safe-to-propose upstream change is only proposed automatically; applying it requires approval of the whole preview, and a dry-run plan is deterministic and stable."
    }
  ]
}